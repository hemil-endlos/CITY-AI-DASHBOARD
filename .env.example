# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# API key that the Detection service must send in X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable auth (dev/local only).
DETECTION_API_KEY=change-me-to-a-strong-random-key

# ── Environment ───────────────────────────────────────────────────────────────
# Set to 0 in production — 1 only for local development
DJANGO_DEBUG=0
# Add your machine's LAN IP here too (from `ipconfig`) so other devices on the
# network can open the dashboard by IP, e.g. 127.0.0.1,localhost,192.168.1.27
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum image upload size in bytes (default: 10 MB)
MAX_UPLOAD_IMAGE_BYTES=10485760

# ── Channels / Redis (optional) ───────────────────────────────────────────────
# Set USE_REDIS_CHANNEL_LAYER=1 and configure Redis for multi-worker deployments
USE_REDIS_CHANNEL_LAYER=0
REDIS_URL=redis://127.0.0.1:6379/0
